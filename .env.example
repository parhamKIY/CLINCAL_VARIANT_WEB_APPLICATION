APP_NAME=Clinical Variant Interpretation

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=your-api-key
LLM_MODEL=model-name
LLM_TIMEOUT=30

VEP_BASE_URL=https://rest.ensembl.org
GENEBE_BASE_URL=https://api.genebe.net/cloud
GENEBE_EMAIL=
GENEBE_API_KEY=
MYVARIANT_BASE_URL=https://myvariant.info/v1
CLINVAR_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
CLINGEN_BASE_URL=https://genome-euro.ucsc.edu/cgi-bin/hubApi
HPO_ONTOLOGY_URL=https://purl.obolibrary.org/obo/hp.obo
HPO_GENE_ASSOCIATIONS_URL_TEMPLATE=https://github.com/obophenotype/human-phenotype-ontology/releases/download/v{release}/phenotype_to_genes.txt
HPO_DISEASE_ANNOTATIONS_URL_TEMPLATE=https://github.com/obophenotype/human-phenotype-ontology/releases/download/v{release}/phenotype.hpoa
GENOME_ASSEMBLY=GRCh38
VEP_BATCH_SIZE=50
ANNOTATION_MAX_RETRIES=2

REQUEST_TIMEOUT=30

LOG_LEVEL=INFO
LOG_PATH=storage/logs/clinical_variant.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=25000000
MAX_UNCOMPRESSED_VCF_BYTES=100000000
REPORT_DIR=storage/reports
DATABASE_PATH=storage/database/clinical_variant.sqlite3
CACHE_DIR=data/cache
HPO_DATA_DIR=data/hpo
